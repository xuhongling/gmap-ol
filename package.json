{
  "name": "gmap-ol",
  "version": "1.0.0",
  "description": "A set of TypeScript helper functions for working with OpenLayers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && npm run check-exports",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "check-exports": "node scripts/check-exports.mjs",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "proj4": "^2.8.0"
  },
  "peerDependencies": {
    "ol": ">=6.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.3",
    "@types/proj4": "^2.5.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "ol": "^9.2.4",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.3.0"
  },
  "author": "xuhongling",
  "license": "MIT",
  "keywords": [
    "ol",
    "openlayers",
    "gmap",
    "gmap-ol",
    "ol-util",
    "ol-tool",
    "olmap",
    "typescript"
  ]
}
